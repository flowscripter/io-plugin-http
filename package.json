{
  "name": "@flowscripter/io-plugin-http",
  "version": "1.0.2",
  "description": "HTTP and HTTPS source/sink plugin for https://github.com/flowscripter/pluggable-io-framework",
  "keywords": [
    "bun",
    "dynamic",
    "framework",
    "http",
    "https",
    "io",
    "pluggable-io-framework",
    "plugin"
  ],
  "homepage": "https://github.com/flowscripter/io-plugin-http#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/io-plugin-http.git"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "dist/bundle.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bundle.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --outdir ./dist --entry-naming bundle.js --target bun --minify --external \"@flowscripter/dynamic-plugin-framework\" && tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@flowscripter/pluggable-io-framework-api": "^3.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@flowscripter/dynamic-plugin-framework": "^2.2.22",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  },
  "peerDependencies": {
    "@flowscripter/dynamic-plugin-framework": "*",
    "typescript": "^7.0.2"
  },
  "pluggable-io-framework": {
    "extensionPoints": [
      "@flowscripter/pluggable-io-framework/provider-factory"
    ]
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
